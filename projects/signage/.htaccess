RewriteEngine On

# Canonical signage host: redirect requests through the portfolio path.
# In this directory's .htaccess, RewriteRule sees only the path relative
# to projects/signage, so subpaths such as admin/ are preserved.
RewriteCond %{HTTP_HOST} ^(www\.)?timoclaessens\.nl$ [NC]
RewriteRule ^(.*)$ https://signage.timoclaessens.nl/$1 [R=301,L,NE]

RewriteBase /

DirectoryIndex index.php

# Admin route
RewriteRule ^admin/?$ admin/index.php [L]

# Alleen screen-routes afvangen als het geen bestaand bestand of map is
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?screen=$1 [L,QSA]